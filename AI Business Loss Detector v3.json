      "parameters": {
        "jsCode": "// Split the reminders array into individual items for processing.\nconst analyzeData = $('Analyze File2').item.json;\nconst reminders = analyzeData.reminders || [];\nconst skipped = analyzeData.reminders_skipped || [];\nconst chatId = String($('Telegram Trigger2').item.json.message.chat.id);\n\nreturn reminders.map(r => ({\n  json: {\n    invoice_id: r.invoice_id,\n    customer: r.customer,\n    email: r.email,\n    amount: r.amount,\n    due_date: r.due_date,\n    message: r.message,\n    sendable: r.sendable,\n    chat_id: chatId\n  }\n}));\n"
      },
