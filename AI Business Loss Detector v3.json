    {
      "parameters": {
        "jsCode": "// Build a single summary from all reminder items.\n// Sent items come from Send Email; skipped items come from Is Sendable? false branch.\nconst analyzeData = $('Analyze File2').item.json;\nconst reminders = analyzeData.reminders || [];\nconst skipped = analyzeData.reminders_skipped || [];\nconst chatId = String($('Telegram Trigger2').item.json.message.chat.id);\n\nconst sendable = reminders.filter(r => r.sendable);\nconst notSendable = reminders.filter(r => !r.sendable);\n\nlet lines = [];\nlines.push('<b>📧 Email Reminder Summary</b>');\nlines.push('');\n\nif (sendable.length > 0) {\n  lines.push(`<b>✅ Sent (${sendable.length}):</b>`);\n  for (const r of sendable) {\n    lines.push(`• ${r.invoice_id} → ${r.customer} (${r.email})`);\n  }\n} else {\n  lines.push('No emails were sent.');\n}\n\nlines.push('');\n\nif (notSendable.length > 0) {\n  lines.push(`<b>⚠️ Skipped (${notSendable.length}):</b>`);\n  for (const r of notSendable) {\n    const reason = r.email ? 'invalid email' : 'no email on file';\n    lines.push(`• ${r.invoice_id} → ${r.customer} (${reason})`);\n  }\n}\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    summary_text: lines.join('\\n')\n  }\n}];\n"
      },
