    {
      "parameters": {
        "fromEmail": "={{ \"xyz2020@gmail.com\" }}",
        "toEmail": "={{ $json.email }}",
        "subject": "=Payment reminder: invoice {{ $json.invoice_id }}",
        "html": "=Hi {{ $json.customer }},\n\nThis is a friendly reminder that invoice **{{ $json.invoice_id }}** for **₹{{ $json.amount }}** is currently overdue.\n\nPlease arrange the payment at your earliest convenience. If you have already made the payment, kindly disregard this reminder.\n\nThank you for your business.\n\nBest regards,  \nAccounts Team",
        "options": {}
